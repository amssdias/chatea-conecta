# =============================================================================
# Chatea Conecta - environment template
#
# Copy to .env in the project root and fill in real values. .env is gitignored.
#
#   cp .env.example .env
#
# docker-compose.prod.yml uses this file two ways:
#   1. Compose interpolates ${MYSQL_USER} etc. when reading the compose file.
#   2. Each Django service loads it via `env_file:` so the app sees these vars.
#
# Keys are deliberately left EMPTY rather than set to "" placeholders: several
# settings use os.getenv(KEY, default) and an empty string would override the
# default. int(os.getenv("EMAIL_PORT", 587)) raises ValueError on "".
# If you do not need an optional key, delete the line rather than blanking it.
# =============================================================================

# --- Core Django (REQUIRED) --------------------------------------------------
SECRET_KEY=

# Comma-separated, no spaces. MUST include localhost or the container
# healthcheck (curl http://localhost:8000/health/) gets a 400 and the
# service is marked unhealthy.
ALLOWED_HOSTS=localhost,127.0.0.1,chatea-conecta.com,www.chatea-conecta.com

# Comma-separated and each entry MUST include the scheme, or Django raises
# system check 4_0.E001. Required for login/signup/checkout POSTs to work.
CSRF_TRUSTED_ORIGINS=https://chatea-conecta.com,https://www.chatea-conecta.com

# Absolute base URL used to build Stripe return URLs and email links.
SITE_URL=https://chatea-conecta.com

# --- MySQL (REQUIRED) --------------------------------------------------------
# MYSQL_* are consumed by Compose interpolation for the `db` service.
# DB_NAME / DB_HOST / DB_PORT are set in docker-compose.prod.yml, not here.
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Redis (REQUIRED) --------------------------------------------------------
# Keep these three DB numbers distinct: cache, channel layer, celery broker.
REDIS_PROTOCOL=redis
REDIS_PASSWORD=
DJANGO_REDIS_CACHE_DB=0
REDIS_DB_CHANNEL=1
REDIS_DB_CELERY=2

# --- Stripe (REQUIRED for payments) ------------------------------------------
# Without these, checkout and webhook verification fail at runtime.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=

# --- Email (REQUIRED for transactional mail) ---------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Chatea Conecta <support@chatea-conecta.com>

# --- AWS (REQUIRED for S3 imports and CloudWatch logging) --------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=

# --- Observability (OPTIONAL) ------------------------------------------------
# NOTE: settings_production.py reads SENTRY_DSN. Older env files used the
# misspelled key SENTRY_DNS, which silently disables Sentry. Use SENTRY_DSN.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Set to true to disable the CloudWatch log handler (useful when AWS
# credentials are absent, otherwise logging setup fails).
SKIP_CLOUDWATCH=false
